<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Isle.entitlements

    Isle ships *outside* the Mac App Store with the hardened runtime and
    without the App Sandbox. The hardened runtime blocks Apple events by
    default, so the automation entitlement below is required for play,
    pause, skip, seek, and artwork requests to reach Apple Music and Spotify.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
